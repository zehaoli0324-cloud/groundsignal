{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroundSignal research target: research labels are not verified legal entities",
  "type": "object", "additionalProperties": false,
  "required": ["id", "name", "aliases", "official_domains", "identity_status", "dimensions", "time_range", "seed_urls"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "aliases": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "official_domains": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}},
    "identity_status": {"const": "UNCONFIRMED"},
    "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["upstream", "downstream", "competitors", "investors", "investments", "people", "products", "capacity", "counterevidence"]}},
    "time_range": {"type": "object", "additionalProperties": false, "required": ["after", "before"], "properties": {"after": {"type": ["string", "null"], "format": "date"}, "before": {"type": ["string", "null"], "format": "date"}}},
    "seed_urls": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "format": "uri", "maxLength": 4096}}
  }
}
